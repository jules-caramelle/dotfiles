    #Prompt compatible avec log IUT
    git_prompt_info() {
    git rev-parse --is-inside-work-tree &>/dev/null || return
    local ref
    ref=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) \
        || ref=$(git describe --tags --exact-match 2>/dev/null) \
        || ref=$(git rev-parse --short HEAD 2>/dev/null) || return
    local dirty=''
    [ -n "$(git status --porcelain 2>/dev/null)" ] && dirty='*'
    printf '\001\e[33m\002 git:(%s%s)\001\e[0m\002' "$ref" "$dirty"
    }

    set_prompt() {
        local EXIT_CHAR="$"
        [ "$UID" -eq 0 ] && EXIT_CHAR="#"
        local IDENTITY="\[\033[01;36m\]\u\[\033[00m\]"
        if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ]; then
            IDENTITY="\[\033[01;36m\]\u\[\033[01;31m\]@\h\[\033[00m\]"
        fi
        PS1="[\t] ${IDENTITY}:\[\033[01;32m\]\W\[\033[00m\]\$(git_prompt_info) ${EXIT_CHAR} "
    }

    _log_to_everywhere() {
        local RET=$?
        local USER_NAME=$(whoami)
        local LAST_CMD=$(history 1 | sed "s/^[ ]*[0-9]*[ ]*//")

        # Log de l'admin (obligatoire)
        history -a
        echo "$$ ${USER_NAME} $(history 1)" >> ~/.bash_eternal_history
        logger -p user.info -t "bash_history" "${USER_NAME} [$$]: ${LAST_CMD} [exit: ${RET}]"

        set_prompt
    }
fi
